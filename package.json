{
  "name": "procedurable",
  "version": "0.1.0",
  "description": "Procedural 3D content generation system with CAD-style modeling and Three.js visualization",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dashboard": "vite --open /dashboard.html",
    "build": "tsc && vite build",
    "build:mcp": "tsc -p tsconfig.mcp.json",
    "preview": "vite preview",
    "test": "jest",
    "test:integration": "tsx src/tests/mcp-integration.test.ts",
    "server": "tsx src/server/index.ts",
    "mcp": "node dist-mcp/mcp/server.js",
    "mcp:dev": "tsx src/mcp/server.ts",
    "mcp:http": "tsx watch src/mcp/http-server.ts",
    "authoring": "tsx watch src/authoring/server.ts",
    "start": "concurrently \"npm run authoring\" \"npm run dashboard\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@types/express": "^5.0.6",
    "@types/uuid": "^10.0.0",
    "concurrently": "^8.2.2",
    "express": "^5.2.1",
    "mathjs": "^15.1.0",
    "three": "^0.160.0",
    "tsx": "^4.21.0",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/three": "^0.160.0",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11"
  }
}
